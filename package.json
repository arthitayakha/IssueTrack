{
  "name": "kanban-issue-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "migration:run": "npm run migration:run --workspace=@kanban/api",
    "migration:generate": "npm run migration:generate --workspace=@kanban/api"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "ajv": "^8.17.1",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.9.2"
}
